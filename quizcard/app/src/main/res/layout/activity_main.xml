<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center|top"
    android:orientation="vertical"
    android:outlineProvider="none"
    android:padding="24dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/button"
            android:layout_width="15dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:onClick="onQuestionNavigatorClicked"
            android:text="Question" />

        <Button
            android:id="@+id/button_select"
            android:layout_width="10dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:onClick="onSelectQuizFileClicked"
            android:text="File" />

        <Button
            android:id="@+id/button_create"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:onClick="onCreateQuizClicked"
            android:text="Create" />

    </LinearLayout>

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1/100" />

    <TextView
        android:id="@+id/questionText"
        android:layout_width="wrap_content"
        android:layout_height="289dp"
        android:layout_marginBottom="24dp"
        android:text="Question"
        android:textColor="#FFFFFF"
        android:textSize="22sp" />

    <Button
        android:id="@+id/choiceA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="onChoiceClicked"
        android:text="A" />

    <Button
        android:id="@+id/choiceB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="onChoiceClicked"
        android:text="B" />

    <Button
        android:id="@+id/choiceC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="onChoiceClicked"
        android:text="C" />

    <Button
        android:id="@+id/choiceD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="onChoiceClicked"
        android:text="D" />

    <View
        android:layout_width="294dp"
        android:layout_height="25dp"
        android:layout_weight="0.5" />

    <Button
        android:id="@+id/read"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center"
        android:onClick="onReadClicked"
        android:text="Read" />

</LinearLayout>

